{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@builders": ["src/builders/index.js"],
      "@builders/*": ["src/builders/*"],
      "@controllers": ["src/controllers/index.js"],
      "@controllers/*": ["src/controllers/*"],
      "@db": ["src/models/index.js"],
      "@enums": ["src/enums/index.js"],
      "@enums/*": ["src/enums/*"],
      "@helpers": ["src/helpers/index.js"],
      "@helpers/*": ["src/helpers/*"],
      "@middleware": ["src/middleware/index.js"],
      "@middleware/*": ["src/middleware/*"],
      "@services": ["src/services/index.js"],
      "@services/*": ["src/services/*"],
      "@queries": ["src/queries/index.js"],
      "@queries/*": ["src/queries/*"],
      "@validations": ["src/validations/index.js"],
      "@validations/*": ["src/validations/*"]
    }
  },
  "include": ["."]
}
