{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@controllers": ["controllers/index.js"],
      "@controllers/*": ["controllers/*"],
      "@db": ["models/index.js"],
      "@enums": ["enums/index.js"],
      "@enums/*": ["enums/*"],
      "@helpers": ["helpers/index.js"],
      "@helpers/*": ["helpers/*"],
      "@middleware": ["middleware/index.js"],
      "@middleware/*": ["middleware/*"],
      "@services": ["services/index.js"],
      "@services/*": ["services/*"]
    }
  },
  "include": ["."]
}
