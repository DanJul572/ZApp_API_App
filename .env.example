# Mode
# Set NODE_ENV in the shell or npm script (e.g. `pnpm dev`); it picks which .env.<NODE_ENV>*
# files are loaded, so a value here only fills in when the shell leaves it unset.
NODE_ENV=

# Port
PORT=

# Secret Key
ENCRYPTION_KEY=

# Client
CLIENT_URL=

#JS Report
JSREPORT_URL=
JSREPORT_USER=
JSREPORT_PASS=

# RabbitMQ
# AMQP port, e.g. amqp://localhost:5673 (not the management UI port). RABBITMQ_USER and
# RABBITMQ_PASS are added to the URL when it has no credentials of its own.
RABBITMQ_URL=
RABBITMQ_USER=
RABBITMQ_PASS=

# Database
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=
DB_DIALECT=
# Log Retention
# Set to true to delete old audit trail, login history and error log rows automatically.
LOG_RETENTION_ENABLED=
# How often the cleanup runs (default 24).
LOG_RETENTION_INTERVAL_HOURS=
# Keep rows for this many days. Empty or 0 keeps them forever.
AUDIT_TRAIL_RETENTION_DAYS=
AUDIT_LOGIN_RETENTION_DAYS=
ERROR_LOG_RETENTION_DAYS=

# View Builder
# Same value as REACT_APP_ENCRYPTION_KEY of the web app
VIEW_ENCRYPTION_KEY=

# Email
# Defaults to <NODE_ENV>_send_email_queue; the worker app must use the same name.
EMAIL_QUEUE_NAME=
# Set to true to send scheduled emails automatically.
EMAIL_SCHEDULER_ENABLED=
# How often due schedules are checked (default 60).
EMAIL_SCHEDULER_INTERVAL_SECONDS=
