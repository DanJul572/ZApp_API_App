# Mode
# Set NODE_ENV in the shell or npm script (e.g. `pnpm dev`); it picks which .env.<NODE_ENV>*
# files are loaded, so a value here only fills in when the shell leaves it unset.
NODE_ENV=

# Port
PORT=

# Secret Key
ENCRYPTION_KEY=

# Client
CLIENT_URL=

#JS Report
JSREPORT_URL=
JSREPORT_USER=
JSREPORT_PASS=

# RabbitMQ
# AMQP port, e.g. amqp://localhost:5673 (not the management UI port). RABBITMQ_USER and
# RABBITMQ_PASS are added to the URL when it has no credentials of its own.
RABBITMQ_URL=
RABBITMQ_USER=
RABBITMQ_PASS=

# Database
DB_HOST=
DB_PORT=
DB_USER=
DB_PASS=
DB_NAME=
DB_DIALECT=

# View Builder
# Same value as REACT_APP_ENCRYPTION_KEY of the web app
VIEW_ENCRYPTION_KEY=

# Email
# Queue the worker app reads send requests from. Defaults to <NODE_ENV>_email_request_queue;
# the worker app must use the same name.
EMAIL_REQUEST_QUEUE_NAME=
