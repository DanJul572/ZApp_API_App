{
  "name": "zapp",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.js",
    "dev": "node ./bin/www",
    "format": "prettier --write .",
    "check": "eslint . --max-warnings=0",
    "migrate:undo": "sequelize db:migrate:undo:all",
    "migrate": "sequelize db:migrate",
    "seed": "sequelize db:seed:all",
    "start": "node dist/app.js",
    "test": "jest"
  },
  "dependencies": {
    "@jsreport/nodejs-client": "^4.1.0",
    "amqplib": "^1.0.2",
    "archiver": "^7.0.1",
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.2",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.20",
    "debug": "~4.4.3",
    "dotenv": "^17.3.1",
    "ejs": "~5.0.1",
    "exceljs": "^4.4.0",
    "express": "~5.2.1",
    "express-rate-limit": "^8.3.1",
    "express-validation": "^4.1.1",
    "http-errors": "~2.0.1",
    "joi": "^18.1.1",
    "jsonwebtoken": "^9.0.3",
    "morgan": "~1.10.1",
    "multer": "^2.1.1",
    "pg": "^8.20.0",
    "pg-copy-streams": "^7.0.0",
    "pg-hstore": "^2.3.4",
    "pg-query-stream": "^4.14.0",
    "sequelize": "^6.37.8",
    "sequelize-cli": "^6.6.5",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.27.4",
    "eslint": "^10.1.0",
    "glob": "^13.0.6",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jest": "^30.3.0",
    "prettier": "^3.8.1"
  },
  "packageManager": "pnpm@10.33.0"
}
