{
  "name": "zapp",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "migrate": "sequelize db:migrate",
    "migrate:undo": "sequelize db:migrate:undo:all",
    "seed": "sequelize db:seed:all",
    "dev": "node ./bin/www",
    "build": "node esbuild.config.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "dayjs": "^1.11.18",
    "debug": "~4.4.3",
    "dotenv": "^17.2.2",
    "ejs": "~3.1.10",
    "express": "~5.1.0",
    "express-validation": "^4.1.1",
    "http-errors": "~2.0.0",
    "husky": "^9.1.7",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "morgan": "~1.10.1",
    "multer": "^2.0.2",
    "mysql2": "^3.15.0",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7",
    "sequelize-cli": "^6.6.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "esbuild": "^0.25.9",
    "eslint": "^9.35.0",
    "glob": "^11.0.3",
    "globals": "^16.4.0",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@10.16.1"
}
