{
  "name": "zapp",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --max-warnings=0",
    "prepare": "husky install",
    "migrate:dev:undo:all": "cross-env NODE_ENV=development sequelize db:migrate:undo:all",
    "migrate:dev": "cross-env NODE_ENV=development sequelize db:migrate",
    "migrate:prod:undo:all": "cross-env NODE_ENV=production sequelize db:migrate:undo:all",
    "migrate:prod": "cross-env NODE_ENV=production sequelize db:migrate",
    "migrate:staging:undo:all": "cross-env NODE_ENV=staging sequelize db:migrate:undo:all",
    "migrate:staging": "cross-env NODE_ENV=staging sequelize db:migrate",
    "seed:dev": "cross-env NODE_ENV=development sequelize db:seed:all",
    "seed:prod": "cross-env NODE_ENV=production sequelize db:seed:all",
    "seed:staging": "cross-env NODE_ENV=staging sequelize db:seed:all",
    "start:dev": "cross-env NODE_ENV=development node ./bin/www",
    "start:prod": "cross-env NODE_ENV=production node ./bin/www",
    "start:staging": "cross-env NODE_ENV=staging node ./bin/www"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "body-parser": "^2.2.0",
    "cookie-parser": "~1.4.7",
    "cors": "^2.8.5",
    "cross-env": "^10.0.0",
    "dayjs": "^1.11.13",
    "debug": "~4.4.1",
    "dotenv-flow": "^4.1.0",
    "ejs": "~3.1.10",
    "express": "~5.1.0",
    "express-validation": "^4.1.1",
    "http-errors": "~2.0.0",
    "joi": "^18.0.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "morgan": "~1.10.1",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "sequelize-cli": "^6.6.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "_moduleAliases": {
    "@controllers": "controllers",
    "@builders": "builders",
    "@db": "models",
    "@enums": "enums",
    "@helpers": "helpers",
    "@middleware": "middleware",
    "@services": "services",
    "@queries": "queries",
    "@validations": "validations"
  },
  "packageManager": "pnpm@10.14.0"
}
