{
    "name": "zapp",
    "version": "0.0.0",
    "private": true,
    "scripts": {
        "start:dev": "cross-env NODE_ENV=development node ./bin/www",
        "migrate:dev": "cross-env NODE_ENV=development sequelize db:migrate",
        "seed:dev": "cross-env NODE_ENV=development sequelize db:seed:all",
        "prepare": "husky install",
        "lint": "eslint . --max-warnings=0",
        "format": "prettier --write ."
    },
    "dependencies": {
        "bcryptjs": "^3.0.2",
        "body-parser": "^2.2.0",
        "cookie-parser": "~1.4.7",
        "cors": "^2.8.5",
        "cross-env": "^7.0.3",
        "dayjs": "^1.11.13",
        "debug": "~4.4.1",
        "dotenv-flow": "^4.1.0",
        "ejs": "~3.1.10",
        "express": "~5.1.0",
        "http-errors": "~2.0.0",
        "jsonwebtoken": "^9.0.2",
        "morgan": "~1.10.0",
        "multer": "^2.0.1",
        "pg": "^8.16.3",
        "pg-hstore": "^2.3.4",
        "sequelize": "^6.37.7"
    },
    "devDependencies": {
        "@eslint/js": "^9.30.1",
        "eslint": "^9.30.1",
        "globals": "^16.3.0",
        "husky": "^9.1.7",
        "prettier": "^3.6.2",
        "sequelize-cli": "^6.6.3"
    },
    "packageManager": "pnpm@10.13.1"
}
